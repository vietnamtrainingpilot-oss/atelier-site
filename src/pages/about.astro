---
import Base from "../layouts/Base.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { AGENTS, ROUTERS } from "../data/routers";
---

<Base title="About">
  <section class="section">
    <div class="container">
      <SectionHeading label="About Atelier" title="The workshop behind the routing layer." lede="Atelier is built around a simple idea: agent work gets better when the right specialist receives the request early." />

      <div class="about-grid">
        <article>
          <p class="label">Why it exists</p>
          <h2>Stop being your own router.</h2>
          <p>Once a project has dozens of skills, choosing the right one becomes work of its own. Atelier replaces that menu with eight domain entry points. The router understands its territory, chooses a lead specialist, adds only the support it needs, and hands off when the boundary is crossed.</p>
        </article>
        <article>
          <p class="label">What it values</p>
          <h2>Useful, explicit, honest.</h2>
          <p>Atelier names its dependencies, documents its limits, and makes its handoffs visible. It does not pretend to cover infrastructure-as-code, database migrations, observability, or API design when those skills are not installed.</p>
        </article>
      </div>

      <div class="about-block">
        <p class="label">The eight domains</p>
        <div class="domain-list">
          {ROUTERS.map((router, index) => <div><span class="label">0{index + 1}</span><strong>{router.title}</strong><span>{router.summary}</span></div>)}
        </div>
      </div>

      <div class="about-block">
        <p class="label">Security agents</p>
        <p class="measure about-copy">The security router carries eight Claude Code subagents. Six are read-only. Findings are verified before patches are generated, and redaction happens before anything leaves the machine.</p>
        <div class="chip-row">{AGENTS.map((agent) => <span class="chip mono">{agent}</span>)}</div>
      </div>

      <div class="about-block about-limit">
        <p class="label">Known limitation</p>
        <p class="measure about-copy">The upstream Claude Code Workflow(...) orchestrator does not run in opencode. The security router documents the dispatch order instead; there is no one-click security scan.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .about-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:1px; background:var(--atelier-rule); border:var(--rule); margin-block-start:clamp(3rem,7vw,6rem); }
  .about-grid article { background:var(--atelier-paper); padding:clamp(1.5rem,4vw,3rem); }
  .about-grid h2 { font-size:var(--step-2); margin-block:1rem; }
  .about-grid p:last-child,.about-copy { color:var(--ink-soft); }
  .about-block { margin-block-start:clamp(3rem,8vw,6rem); padding-block-start:2rem; border-top:var(--rule); }
  .domain-list { margin-block-start:1rem; border-top:var(--rule); }
  .domain-list div { display:grid; grid-template-columns:3rem minmax(10rem,18rem) 1fr; gap:1rem; padding:1rem 0; border-bottom:var(--rule); align-items:baseline; }
  .domain-list span:last-child { color:var(--atelier-muted); font-size:var(--step--1); }
  .chip-row { display:flex; flex-wrap:wrap; gap:.5rem; margin-block-start:1rem; }
  .chip { padding:.22em .6em; background:var(--mark-wash); color:var(--mark-deep); font-size:.78rem; border-radius:var(--radius); }
  .about-limit { margin-block-end:2rem; }
  @media (max-width:720px) { .about-grid { grid-template-columns:1fr; } .domain-list div { grid-template-columns:2rem 1fr; } .domain-list span:last-child { grid-column:2; } }
</style>
