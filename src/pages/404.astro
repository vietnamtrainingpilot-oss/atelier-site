---
import Base from "../layouts/Base.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { url } from "../data/site";
---

<Base title="Not found" noindex>
  <section class="section">
    <div class="container">
      <SectionHeading label="404" title="Page not found." lede="The page you asked for isn't here. The routers and the install guide are both at the top of this page." />
      <div class="notfound__cta">
        <a class="btn btn--mark" href={url("/")}>Back to home</a>
        <a class="btn" href={url("/install/")}>Install Atelier</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .notfound__cta { display:flex; flex-wrap:wrap; gap:1rem; margin-block-start:2rem; }
</style>