---
import Base from "../layouts/Base.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { ROUTERS, routerBySlug } from "../data/routers";
import { url } from "../data/site";
---

<Base title="Routers">
  <section class="section">
    <div class="container">
      <SectionHeading
        label="Routers"
        title="Eight domains, one interface."
        lede="Each router is a self-contained specialist with its own curated skills. Ask for the outcome, not the tool."
      />
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      {ROUTERS.map((router) => {
        const r = routerBySlug(router.slug)!;
        return (
          <article class="router-detail" id={r.slug}>
            <div class="router-detail__head">
              <span class="label router-detail__num">0{ROUTERS.indexOf(r) + 1}</span>
              <h2 class="router-detail__title">{r.title}</h2>
              <span class="label router-detail__count">{r.n} skills</span>
            </div>

            <p class="lede router-detail__summary">{r.summary}</p>

            <div class="router-detail__chips">
              <span class="label router-detail__chip-label">Dispatches to</span>
              {r.requires.map((skill) => (
                <span class="chip mono">{skill}</span>
              ))}
            </div>

            {r.handoffs.length > 0 && (
              <p class="router-detail__handoff">
                <span class="label">Handoffs to</span>{" "}
                {r.handoffs.map((h) => {
                  const target = routerBySlug(h);
                  return target ? (
                    <a href={url("/routers/") + h + "/"}>{target.title}</a>
                  ) : (
                    <span>{h}</span>
                  );
                })}
              </p>
            )}

            {r.env && r.env.length > 0 && (
              <div class="router-detail__env">
                <p class="label">Environment variables</p>
                <code class="mono">{r.env.join("  ·  ")}</code>
              </div>
            )}

            {r.mcp && r.mcp.length > 0 && (
              <div class="router-detail__mcp">
                <p class="label">MCP servers</p>
                <code class="mono">{r.mcp.join("  ·  ")}</code>
              </div>
            )}

            {r.notes && (
              <p class="router-detail__notes">
                <span class="label">Note</span> {r.notes}
              </p>
            )}
          </article>
        );
      })}

      <div class="routers__agents">
        <p class="label">Security subagents</p>
        <p class="lede routers__agents-lede">
          The security router dispatches eight ported Claude Code subagents
          in order. They do not run inside opencode — invoke them manually.
        </p>
        <div class="chip-row">
          <span class="chip mono">cs-explore</span>
          <span class="chip mono">cs-scan-inventory</span>
          <span class="chip mono">cs-scan-researcher</span>
          <span class="chip mono">cs-scan-verifier</span>
          <span class="chip mono">cs-scan-loader</span>
          <span class="chip mono">cs-scan-redactor</span>
          <span class="chip mono">cs-patch-generator</span>
          <span class="chip mono">cs-patch-verifier</span>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .router-detail {
    position: relative;
    margin-block: clamp(2rem, 6vw, 4rem);
    padding: clamp(2rem, 5vw, 3.5rem);
    background: var(--paper-raised);
    border: var(--rule);
    border-radius: var(--radius);
    border-top: 2px solid var(--atelier-rule);
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    transition: transform 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out);
  }

  .router-detail:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(180,85,45,0.15);
    border-top-color: var(--atelier-mark);
  }

  .router-detail:first-of-type {
    border-top: 0;
  }

  .router-detail__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem 1.25rem;
    padding-block-end: 0.75rem;
    border-block-end: var(--rule);
  }

  .router-detail__title {
    font-size: var(--step-2);
    font-weight: 500;
    line-height: 1.2;
    color: var(--atelier-ink);
    flex: 1 1 auto;
    min-width: 10ch;
  }

  .router-detail__num,
  .router-detail__count {
    flex: none;
    font-size: 0.7rem;
    color: var(--atelier-muted);
  }

  .router-detail__count {
    color: var(--atelier-mark);
    background: var(--mark-wash);
    padding: 0.1em 0.4em;
    border-radius: var(--radius);
  }

  .router-detail__summary {
    margin-block-start: 1rem;
    color: var(--ink-soft);
    font-size: var(--step--1);
    line-height: 1.55;
    max-width: 48ch;
  }

  .router-detail__chips {
    margin-block-start: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .router-detail__chip-label {
    margin-inline-end: 0.5rem;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--atelier-muted);
  }

  .chip {
    display: inline-block;
    padding: 0.2em 0.55em;
    background: var(--mark-wash);
    color: var(--mark-deep);
    font-size: 0.7rem;
    border-radius: var(--radius);
    font-family: var(--font-mono);
  }

  .router-detail__handoff {
    margin-block-start: 1.5rem;
    color: var(--ink-soft);
    font-size: var(--step--1);
    line-height: 1.5;
  }

  .router-detail__handoff a {
    color: var(--atelier-mark);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .router-detail__env,
  .router-detail__mcp {
    margin-block-start: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    align-items: center;
  }

  .router-detail__env code,
  .router-detail__mcp code {
    color: var(--ink-soft);
    font-size: 0.82rem;
  }

  .router-detail__notes {
    margin-block-start: 1rem;
    color: var(--ink-soft);
    font-size: var(--step--1);
    max-width: var(--measure);
  }

  .routers__agents {
    margin-block-start: clamp(3rem, 8vw, 6rem);
    padding-block: clamp(2rem, 5vw, 3.5rem);
    border-top: var(--rule);
  }

  .routers__agents-lede {
    margin-block-start: 0.75rem;
    max-width: var(--measure);
  }

  .chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block-start: 1rem;
  }
</style>