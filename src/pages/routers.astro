---
import Base from "../layouts/Base.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { ROUTERS, routerBySlug } from "../data/routers";
import { url } from "../data/site";
import RouterGrid from "../components/RouterGrid.astro";
---

<Base title="Routers">
  <section class="section">
    <div class="container">
      <SectionHeading
        label="Routers"
        title="Eight domains, one interface."
        lede="Each router is a self-contained specialist with its own curated skills. Ask for the outcome, not the tool."
      />
      <p class="center-para" style="text-align: center; color: var(--ink-soft); margin-block-start: 1rem; margin-block-end: 2rem; font-size: var(--step--1);">
        Streamlined dispatch across eight specialized domains — one outcome, one specialist.
      </p>
      <div class="routergrid" data-reveal-stagger>
        <RouterGrid />
      </div>
    </div>
  </section>
</Base>

<style>
  .center-para {
    text-align: center;
    color: var(--ink-soft);
    margin-block-start: 1rem;
    margin-block-end: 2rem;
    font-size: var(--step--1);
  }
</style>