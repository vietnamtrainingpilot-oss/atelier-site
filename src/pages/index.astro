---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import RouterGrid from "../components/RouterGrid.astro";
import RoutingDiagram from "../components/RoutingDiagram.astro";
import ProofStrip from "../components/ProofStrip.astro";
import InstallBox from "../components/InstallBox.astro";
import { ROUTERS, TOTAL_DEPS, UNIQUE_SKILLS, BUNDLED, FETCHED, HOSTS } from "../data/routers";
import { url } from "../data/site";
---

<Base title="Home">
  <Hero />

  <section class="section section--dark">
    <div class="container">
      <div class="eyebrow-row" data-reveal>
        <span class="label">what it is</span>
        <span class="rule-inline"></span>
        <span class="label label--mark">dispatch layer</span>
      </div>
      <h2 class="section-title" data-reveal>
        A routing layer<br class="section-br" />for agent work.
      </h2>
      <p class="section-lede" data-reveal>
        Atelier is an opencode and Claude plugin. You describe the work you need done,
        and it routes the request to the specialist skill that does it best — across
        eight domains, with dependencies bundled for offline use.
      </p>
    </div>

    <div class="feature-grid">
      <div class="feature-card" data-reveal-stagger>
        <span class="feature-num mono">01</span>
        <span class="label feature-label">8 routers</span>
        <h3>One skill per domain</h3>
        <p>Web design, video production, SEO, backend, payments, security, vibe coding, and shipping. Each router holds its own specialist skills and knows which one to hand the work to.</p>
      </div>
      <div class="feature-card" data-reveal-stagger>
        <span class="feature-num mono">02</span>
        <span class="label feature-label">105 skills</span>
        <h3>Specialists, not generalists</h3>
        <p>Every skill is hand-picked for a specific job. No generic "build a website" prompt — the right tool for the right moment.</p>
      </div>
      <div class="feature-card" data-reveal-stagger>
        <span class="feature-num mono">03</span>
        <span class="label feature-label">36 bundled</span>
        <h3>Install works offline</h3>
        <p>The most-used skills ship inside the plugin. The rest are fetched from public sources on install, so the first run never waits on a slow network.</p>
      </div>
      <div class="feature-card" data-reveal-stagger>
        <span class="feature-num mono">04</span>
        <span class="label feature-label">7 hosts</span>
        <h3>One plugin, every agent</h3>
        <p>Works with opencode, Claude Code, Cursor, Codex, Windsurf, Gemini, and any agent that supports custom skills. Auto-detects your host on install.</p>
      </div>
    </div>
  </section>

  <section class="section section--light" id="routers">
    <div class="container">
      <div class="eyebrow-row" data-reveal>
        <span class="label">the routers</span>
        <span class="rule-inline"></span>
        <span class="label label--mark">{ROUTERS.length} domains</span>
      </div>
      <h2 class="section-title section-title--light" data-reveal>
        Eight domains,<br class="section-br" />one interface.
      </h2>
      <p class="section-lede section-lede--light" data-reveal>
        Each router is a self-contained specialist. Ask for the outcome, not the tool.
      </p>
    </div>
    <div class="routergrid" data-reveal-stagger>
      <RouterGrid />
    </div>
  </section>

  <section class="section section--dark">
    <div class="container">
      <RoutingDiagram />
    </div>
  </section>

  <section class="section section--light">
    <div class="container">
      <div class="eyebrow-row" data-reveal>
        <span class="label">how it routes</span>
        <span class="rule-inline"></span>
        <span class="label label--mark">intent → dispatch</span>
      </div>
      <h2 class="section-title" data-reveal>
        One verb in.<br />One specialist out.
      </h2>
      <p class="section-lede" data-reveal>
        A router reads the intent, picks the domain, and dispatches the exact skill
        that owns the work — then hands off when another domain takes over.
      </p>
    </div>
  </section>

  <ProofStrip />

  <section class="section section--dark" id="install">
    <div class="container">
      <div class="eyebrow-row" data-reveal>
        <span class="label">install</span>
        <span class="rule-inline"></span>
        <span class="label label--mark">one line</span>
      </div>
      <h2 class="section-title" data-reveal>
        One command,<br />then you're routing.
      </h2>
      <p class="section-lede" data-reveal>
        Node 18 or later. The bundled skills install offline; the rest fetch from
        public sources as part of the same command.
      </p>
      <div class="cta-row" data-reveal>
        <InstallBox command="node install.mjs" variant="mark" />
        <a class="btn btn--ghost" href={url("/install/")}>Full install guide →</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .section--dark {
    background: var(--atelier-ink);
    color: var(--atelier-paper);
    padding-block: clamp(5rem, 12vw, 10rem);
  }

  .section--light {
    background: var(--atelier-paper);
    color: var(--atelier-ink);
    padding-block: clamp(5rem, 12vw, 10rem);
  }

  .eyebrow-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-block-end: 1.5rem;
    flex-wrap: wrap;
  }

  .rule-inline {
    flex: 1;
    min-width: 3rem;
    max-width: 12rem;
    height: 1px;
    background: var(--atelier-rule);
    opacity: 0.5;
  }

  .section--light .rule-inline {
    background: var(--atelier-ink);
  }

  .section-title {
    font-size: clamp(2.4rem, 6vw, 5.5rem);
    line-height: 1.0;
    letter-spacing: -0.03em;
    font-weight: 500;
    margin: 0 0 1.25rem;
    max-width: 14ch;
  }

  .section-title--light {
    color: var(--atelier-ink);
  }

  .section-br {
    display: none;
  }

  @media (min-width: 640px) {
    .section-br { display: block; }
  }

  .section-lede {
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    line-height: 1.55;
    color: rgba(245, 242, 236, 0.55);
    max-width: 52ch;
    margin-block-end: clamp(3rem, 8vw, 5rem);
  }

  .section-lede--light {
    color: var(--ink-soft);
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: rgba(245, 242, 236, 0.07);
    border: 1px solid rgba(245, 242, 236, 0.08);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .feature-card {
    background: var(--atelier-ink);
    padding: clamp(1.75rem, 4vw, 3rem);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: background-color 0.3s var(--ease-out);
  }

  .feature-card:hover {
    background: rgba(245, 242, 236, 0.03);
  }

  .feature-num {
    font-size: 0.65rem;
    color: var(--atelier-mark);
    letter-spacing: 0.1em;
  }

  .feature-label {
    color: rgba(245, 242, 236, 0.4);
  }

  .feature-card h3 {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.5vw, 1.75rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--atelier-paper);
    margin: 0;
  }

  .feature-card p {
    color: rgba(245, 242, 236, 0.45);
    font-size: var(--step--1);
    line-height: 1.6;
    max-width: 42ch;
  }

  @media (max-width: 720px) {
    .feature-grid {
      grid-template-columns: 1fr;
    }
  }

  .steps-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: rgba(20, 18, 15, 0.08);
    border: 1px solid var(--atelier-rule);
    border-radius: var(--radius);
    overflow: hidden;
    margin-block-start: clamp(2.5rem, 6vw, 4rem);
  }

  .steps-item {
    background: var(--atelier-paper);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .steps-num {
    font-size: 0.65rem;
    color: var(--atelier-mark);
    letter-spacing: 0.12em;
  }

  .steps-item p {
    color: var(--ink-soft);
    font-size: var(--step--1);
    line-height: 1.55;
  }

  @media (max-width: 820px) {
    .steps-list { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 460px) {
    .steps-list { grid-template-columns: 1fr; }
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-block-start: 2rem;
  }

  .cta-row :global(.installbox) {
    min-width: min(22rem, 100%);
  }

  /* routergrid shared styles */
  .routergrid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0 clamp(1.5rem, 4vw, 3.5rem);
    margin-block-start: clamp(2.5rem, 6vw, 5rem);
  }

  @media (max-width: 720px) {
    .routergrid { grid-template-columns: 1fr; }
  }
</style>
