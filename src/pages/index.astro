---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import RouterGrid from "../components/RouterGrid.astro";
import RoutingDiagram from "../components/RoutingDiagram.astro";
import ProofStrip from "../components/ProofStrip.astro";
import InstallBox from "../components/InstallBox.astro";
import { ROUTER_COUNT, ROUTERS, TOTAL_DEPS, UNIQUE_SKILLS } from "../data/routers";
import { url } from "../data/site";
---

<Base title="Home">
  <Hero />

  <section class="section section--raised">
    <div class="container">
      <SectionHeading
        label="What it is"
        title="A dispatch layer for agent work."
        lede="Atelier is an opencode and Claude plugin. You describe the work you need done, and it routes the request to the specialist skill that does it best — across eight domains, with the dependencies bundled so the first run works offline."
      />

      <div class="what-grid">
        <div class="what-card">
          <p class="label">8 routers</p>
          <h3>One skill per domain</h3>
          <p>Web design, video production, SEO, backend, payments, security, vibe coding, and shipping. Each router holds its own specialist skills and knows which one to hand the work to.</p>
        </div>
        <div class="what-card">
          <p class="label">105 unique skills</p>
          <h3>Specialists, not generalists</h3>
          <p>Every skill is hand-picked for a specific job. No generic "build a website" prompt — the right tool for the right moment.</p>
        </div>
        <div class="what-card">
          <p class="label">36 bundled</p>
          <h3>Install works offline</h3>
          <p>The most-used skills ship inside the plugin. The rest are fetched from public sources on install, so the first run never waits on a slow network.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <SectionHeading
        label="Routers"
        title="Eight domains, one interface."
        lede="Each router is a self-contained specialist. Ask for the outcome, not the tool."
        id="routers"
      />
      <RouterGrid />
    </div>
  </section>

  <RoutingDiagram />

  <section class="section section--muted">
    <div class="container">
      <SectionHeading
        label="How it routes"
        title="Intent in, specialist out."
        lede="You say what you want. Atelier parses the intent, picks the domain router, and dispatches to the specialist skill. The handoff is explicit — the router always names what it is delegating to."
      />
      <ul class="flow">
        <li><span class="label">01</span><p>You describe the work in plain language.</p></li>
        <li><span class="label">02</span><p>Atelier classifies the intent against its eight domain routers.</p></li>
        <li><span class="label">03</span><p>The router dispatches to its specialist skill with context intact.</p></li>
        <li><span class="label">04</span><p>The result comes back through the same chain.</p></li>
      </ul>
    </div>
  </section>

  <ProofStrip />

  <section class="section section--tight">
    <div class="container">
      <SectionHeading
        label="Install"
        title="One line, then you're routing."
        lede="Node 18 or later. The bundled skills install offline; the rest fetch from public sources as part of the same command."
        id="install"
      />
      <div class="cta-row">
        <InstallBox command="node install.mjs" variant="mark" />
        <a class="btn btn--mark" href={url("/install/")}>Full install guide</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .what-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1rem, 2vw, 1.5rem);
    margin-block-start: clamp(2.5rem, 6vw, 5rem);
  }

  .what-card {
    background: var(--paper-raised);
    border: var(--rule);
    border-top: 2px solid var(--atelier-rule);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    border-radius: var(--radius);
    transition: transform 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out);
  }

  .what-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(20,18,15,0.08);
    border-top-color: var(--atelier-mark);
  }

  .what-card h3 {
    font-size: var(--step-1);
    line-height: 1.2;
  }

  .what-card p {
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  @media (max-width: 820px) {
    .what-grid {
      grid-template-columns: 1fr;
    }
  }

  .flow {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--atelier-rule);
    margin-block-start: clamp(2.5rem, 6vw, 5rem);
    border: var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .flow li {
    background: var(--paper-raised);
    padding: clamp(1.25rem, 2.5vw, 2rem);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .flow p {
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  @media (max-width: 820px) {
    .flow {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 460px) {
    .flow {
      grid-template-columns: 1fr;
    }
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-block-start: 1.5rem;
  }
</style>