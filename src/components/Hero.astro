---
import { SITE, url } from "../data/site";
import InstallBox from "./InstallBox.astro";

const ROUTER_NAMES = [
  "web-design",
  "video-production",
  "seo",
  "backend",
  "payments",
  "security",
  "vibe-code",
  "ship-it",
];
---

<section class="hero grain">
  <div class="container hero__inner">
    <p class="label hero__eyebrow" data-reveal>A skill dispatch plugin</p>

    <h1 class="hero__title">
      <span class="reveal-type"><span class="reveal-type__inner" data-hero-line>{SITE.wordmark}</span></span>
    </h1>

    <p class="lede hero__lede" data-reveal>
      {SITE.tagline} Say what you want to build. Atelier routes the work to the
      specialist skill that does it best.
    </p>

    <div class="hero__cta" data-reveal>
      <InstallBox command="node install.mjs" variant="mark" />
      <a class="btn" href={url("/routers/")}>See the 8 routers</a>
    </div>

    <div class="hero__drift" aria-hidden="true">
      {ROUTER_NAMES.map((name) => <span class="hero__drift-name mono">{name}</span>)}
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block-start: clamp(7rem, 18vh, 12rem);
    padding-block-end: clamp(3rem, 8vw, 6rem);
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, var(--paper-deep) 0%, var(--atelier-paper) 100%);
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.6rem;
  }

  .hero__eyebrow {
    margin-block-end: 0.25rem;
  }

  .hero__title {
    font-size: var(--step-5);
    line-height: 0.98;
    letter-spacing: -0.02em;
  }

  .hero__lede {
    font-size: var(--step-2);
    max-width: 30ch;
    color: var(--ink-soft);
    line-height: 1.3;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-block-start: 0.75rem;
  }

  .hero__cta :global(.installbox) {
    min-width: min(22rem, 100%);
  }

  .hero__drift {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 2.25rem;
    margin-block-start: clamp(2rem, 6vw, 4rem);
    padding-block-start: 1.5rem;
    border-top: var(--rule);
    width: 100%;
  }

  .hero__drift-name {
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    color: var(--atelier-muted);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__drift {
      animation: drift-in 1.2s var(--ease-out) both;
      animation-delay: 0.6s;
    }
  }

  @keyframes drift-in {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
