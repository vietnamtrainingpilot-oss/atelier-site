---
interface Props {
  command: string;
  title?: string;
  note?: string;
  variant?: "mark" | "plain";
}

const { command, title, note, variant = "plain" } = Astro.props;
---

<div class={`installbox installbox--${variant}`} data-reveal>
  {title && <p class="label installbox__title">{title}</p>}
  <div class="installbox__row">
    <code class="installbox__cmd"><span aria-hidden="true">$ </span>{command}</code>
    <button
      class="installbox__copy mono"
      type="button"
      data-copy={command}
      aria-label={`Copy command: ${command}`}
    >
      Copy
    </button>
  </div>
  {note && <p class="installbox__note">{note}</p>}
</div>

<style>
  .installbox {
    border: var(--rule);
    border-left: 2px solid var(--atelier-rule);
    background: var(--paper-raised);
    padding: 1rem 1.15rem;
    border-radius: var(--radius);
  }

  .installbox--mark {
    border-left-color: var(--atelier-mark);
  }

  .installbox__title {
    margin-block-end: 0.7rem;
  }

  .installbox__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .installbox__cmd {
    font-family: var(--font-mono);
    font-size: clamp(0.78rem, 2.6vw, 0.95rem);
    color: var(--atelier-ink);
    overflow-x: auto;
    white-space: nowrap;
    scrollbar-width: thin;
  }

  .installbox__copy {
    flex: none;
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.4em 0.7em;
    color: var(--atelier-muted);
    background: transparent;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    transition: color 0.2s var(--ease-out), border-color 0.2s var(--ease-out),
      background-color 0.2s var(--ease-out);
  }

  .installbox__copy:hover {
    color: var(--atelier-paper);
    background: var(--atelier-mark);
    border-color: var(--atelier-mark);
  }

  .installbox__note {
    margin-block-start: 0.75rem;
    font-size: var(--step--1);
    color: var(--atelier-muted);
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const value = btn.getAttribute("data-copy") || "";
      try {
        await navigator.clipboard.writeText(value);
        const prev = btn.textContent;
        btn.textContent = "Copied";
        window.setTimeout(() => {
          btn.textContent = prev;
        }, 1400);
      } catch {
        /* clipboard unavailable — command stays selectable */
      }
    });
  });
</script>
