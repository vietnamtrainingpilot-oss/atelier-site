---
import { NAV, SITE, url } from "../data/site";

const path = Astro.url.pathname;

function isActive(href: string): boolean {
  const full = url(href);
  if (href === "/") {
    return path === full || path === full.replace(/\/$/, "");
  }
  return path.startsWith(full);
}
---

<header class="nav" data-nav>
  <div class="container nav__inner">
    <a class="nav__brand mono" href={url("/")} aria-label={`${SITE.name} home`}>
      {SITE.wordmark}
    </a>

    <nav class="nav__links" aria-label="Primary">
      {
        NAV.map((item) => (
          <a
            href={url(item.href)}
            class="nav__link"
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a class="nav__link nav__link--ext" href={SITE.repo} rel="noopener">
        GitHub
      </a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--atelier-paper) 82%, transparent);
    backdrop-filter: saturate(140%) blur(8px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.4s var(--ease-out), background-color 0.4s
      var(--ease-out);
  }

  .nav.is-scrolled {
    border-bottom-color: var(--atelier-rule);
    background: color-mix(in srgb, var(--atelier-paper) 92%, transparent);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 64px;
  }

  .nav__brand {
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    color: var(--atelier-ink);
  }

  .nav__brand:hover {
    color: var(--atelier-mark);
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2.5vw, 1.75rem);
  }

  .nav__link {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--atelier-muted);
    padding-block: 0.25rem;
    border-bottom: 1px solid transparent;
    transition: color 0.25s var(--ease-out), border-color 0.25s var(--ease-out);
  }

  .nav__link:hover,
  .nav__link[aria-current="page"] {
    color: var(--atelier-ink);
    border-bottom-color: var(--atelier-mark);
  }

  .nav__link--ext::after {
    content: " ↗";
    color: var(--atelier-muted);
  }
</style>
