---
import { BUNDLED, FETCHED, HOSTS, ROUTER_COUNT, TOTAL_DEPS, UNIQUE_SKILLS } from "../data/routers";

const stats = [
  { n: ROUTER_COUNT, label: "domain routers" },
  { n: TOTAL_DEPS, label: "dependencies" },
  { n: UNIQUE_SKILLS, label: "unique skills" },
  { n: BUNDLED, label: "bundled offline" },
  { n: FETCHED, label: "fetched on install" },
  { n: HOSTS, label: "supported hosts" },
];
---

<section class="proof section--tight" aria-label="By the numbers">
  <div class="container">
    <hr class="hairline" />
    <div class="proof__grid" data-reveal-stagger>
      {
        stats.map((s) => (
          <div class="proof__cell">
            <span class="proof__num">{s.n}</span>
            <span class="label">{s.label}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .proof__grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1px;
    background: var(--atelier-rule);
    padding-block: 2.25rem;
    border: var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .proof__cell {
    background: var(--paper-raised);
    padding: 0.5rem clamp(0.75rem, 2vw, 1.5rem);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .proof__num {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1;
    color: var(--atelier-mark);
  }

  @media (max-width: 820px) {
    .proof__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 460px) {
    .proof__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
