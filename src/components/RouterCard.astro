---
import type { Router } from "../data/routers";
import { url } from "../data/site";

interface Props {
  router: Router;
  index: number;
}

const { router, index } = Astro.props;
const num = String(index + 1).padStart(2, "0");
---

<article class="routercard" data-reveal style={`--i:${index}`}>
  <span class="routercard__rule" aria-hidden="true"></span>
  <header class="routercard__head">
    <span class="routercard__num mono">{num}</span>
    <h3 class="routercard__title">{router.title}</h3>
    <span class="routercard__count mono" aria-label={`${router.n} dependencies`}>{router.n}</span>
  </header>

  <p class="routercard__summary">{router.summary}</p>

  <div class="routercard__reveal" aria-hidden="false">
    <ul class="routercard__skills mono">
      {router.requires.slice(0, 8).map((skill) => <li>{skill}</li>)}
      {router.requires.length > 8 && <li class="routercard__more">+{router.requires.length - 8} more</li>}
    </ul>
  </div>

  <footer class="routercard__foot">
    <a class="routercard__link label" href={url("/routers/")}>Details</a>
    {
      router.handoffs.length > 0 && (
        <span class="routercard__handoff mono" aria-label="Task router does not run it — it returns a handoff to">
          handoff → {router.handoffs.join(", ")}
        </span>
      )
    }
  </footer>
</article>

<style>
  .routercard {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.5rem 1.6rem 1.25rem;
    background: var(--paper-raised);
    border: var(--rule);
    border-radius: var(--radius);
    border-top: 2px solid var(--atelier-rule);
    transition: transform 0.35s var(--ease-out), box-shadow 0.35s var(--ease-out),
      background-color 0.35s var(--ease-out), border-top-color 0.35s var(--ease-out);
    box-shadow: 0 1px 3px rgba(20,18,15,0.04);
  }

  .routercard:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(20,18,15,0.08);
    border-top-color: var(--atelier-mark);
  }

  .routercard__rule {
    display: none;
  }

  .routercard__head {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding-block-end: 0.75rem;
    border-block-end: var(--rule);
  }

  .routercard__num {
    font-size: 0.7rem;
    color: var(--atelier-muted);
  }

  .routercard__title {
    font-size: var(--step-1);
    margin: 0;
    line-height: 1.2;
  }

  .routercard__count {
    margin-inline-start: auto;
    font-size: 0.78rem;
    color: var(--atelier-mark);
    background: var(--mark-wash);
    padding: 0.15em 0.5em;
    border-radius: var(--radius);
  }

  .routercard__summary {
    color: var(--ink-soft);
    font-size: var(--step--1);
    line-height: 1.55;
    max-width: 44ch;
  }

  .routercard__reveal {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.45s var(--ease-out);
  }

  .routercard:hover .routercard__reveal,
  .routercard:focus-within .routercard__reveal {
    max-height: 12rem;
  }

  .routercard__skills {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.6rem;
    font-size: 0.68rem;
    color: var(--atelier-muted);
    padding-block: 0.25rem 0.35rem;
  }

  .routercard__skills li::after {
    content: " ·";
    color: var(--atelier-rule);
  }

  .routercard__skills li:last-child::after {
    content: "";
  }

  .routercard__more {
    color: var(--atelier-mark);
  }

  .routercard__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1rem;
    margin-block-start: auto;
    padding-block-start: 0.75rem;
    border-block-start: var(--rule);
  }

  .routercard__link {
    color: var(--atelier-mark);
  }

  .routercard__link:hover {
    color: var(--mark-deep);
  }

  .routercard__handoff {
    font-size: 0.66rem;
    color: var(--atelier-muted);
  }

  /* Dark theme override (when parent has data-theme="dark") */
  [data-theme="dark"] .routercard {
    background: rgba(245, 242, 236, 0.03);
    border-color: rgba(245, 242, 236, 0.08);
    border-top-color: rgba(245, 242, 236, 0.15);
    box-shadow: none;
  }

  [data-theme="dark"] .routercard:hover {
    background: rgba(245, 242, 236, 0.05);
    border-top-color: var(--atelier-mark);
    box-shadow: 0 4px 20px rgba(0,0,0,0.3);
  }

  [data-theme="dark"] .routercard__head {
    border-block-end-color: rgba(245, 242, 236, 0.08);
  }

  [data-theme="dark"] .routercard__num {
    color: var(--atelier-mark);
  }

  [data-theme="dark"] .routercard__title {
    color: var(--atelier-paper);
  }

  [data-theme="dark"] .routercard__summary {
    color: rgba(245, 242, 236, 0.5);
  }

  [data-theme="dark"] .routercard__skills {
    color: rgba(245, 242, 236, 0.35);
  }

  [data-theme="dark"] .routercard__skills li::after {
    color: rgba(245, 242, 236, 0.15);
  }

  [data-theme="dark"] .routercard__foot {
    border-block-start-color: rgba(245, 242, 236, 0.08);
  }

  [data-theme="dark"] .routercard__handoff {
    color: rgba(245, 242, 236, 0.35);
  }
</style>
